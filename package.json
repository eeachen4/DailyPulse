{
  "name": "dailypulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DailyPulse — 每日自动聚合 App Store / Google Play / Product Hunt / Reddit 全球热门内容的「信息早餐」",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate": "tsx src/storage/generateHtml.ts",
    "build:all": "npm run build && npm run generate",
    "fetch": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
