# ============ 数据源密钥 ============
# Product Hunt 官方 API Token（推荐；未配置时回退 Apify）
# 获取：https://www.producthunt.com/v2/oauth/applications -> 创建应用 -> Developer Token
PRODUCT_HUNT_TOKEN=

# Apify API Token（现在仅作为 Product Hunt 的兜底，其余源无需）
# 获取：https://console.apify.com/settings/integrations -> Personal API tokens
APIFY_API_KEY=

# Product Hunt 兜底 Actor（一般无需修改）
APIFY_PRODUCT_HUNT_ACTOR_ID=glassventures~product-hunt-scraper

# ============ 每类别采集数量（按来源分别控制）============
APP_STORE_MAX_ITEMS=30
GOOGLE_PLAY_MAX_ITEMS=30
PRODUCT_HUNT_MAX_ITEMS=20
REDDIT_LIMIT=30

# ============ 地区 ============
APP_STORE_COUNTRY=us
GOOGLE_PLAY_COUNTRY=us

# ============ Reddit ============
# 方式一（推荐）：官方 OAuth，CI 免代理即可抓
# 获取：https://www.reddit.com/prefs/apps -> 创建 "installed app"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# 方式二（可选）：HTTP 代理出口，数据中心 IP 被 403 时用
# 格式：http://username:password@host:port
REDDIT_PROXY=

# ============ Bluesky / Mastodon / GDELT / Hacker News（无需 token） ============
# Bluesky 公共搜索若遇到 403，可配置免费 App Password 提高稳定性
BSKY_IDENTIFIER=
BSKY_APP_PASSWORD=
# Mastodon 实例，默认 mastodon.social；可替换为更适合目标地区的实例
MASTODON_INSTANCE=mastodon.social
# 各源每个类别的最大条数
BLUESKY_LIMIT=25
MASTODON_LIMIT=25
GDELT_LIMIT=25
HACKER_NEWS_LIMIT=25

# ============ GitHub / Hugging Face / Stack Overflow / arXiv / RSS ============
# GitHub 未配置时使用公共额度；配置 Token 可提升 API 限额
GITHUB_API_TOKEN=
GITHUB_LIMIT=25
HUGGING_FACE_LIMIT=25
STACKOVERFLOW_LIMIT=25
ARXIV_LIMIT=25
RSS_LIMIT=25

# ============ 详情抓取 ============
# 是否在采集后从来源网页抓取详情（完整描述/截图/评分等）；false 关闭
SCRAPE_DETAILS=true
# 详情抓取并发数
SCRAPE_DETAILS_CONCURRENCY=4

# 单个 Apify run 最长等待时间（秒，仅 PH 兜底用到）
APIFY_RUN_TIMEOUT_SECS=300
