# 必填：Apify API Token
# 获取方式：https://console.apify.com/settings/integrations -> Personal API tokens
APIFY_API_KEY=

# 可选：各数据源对应的 Apify Actor ID（已内置默认值，一般无需修改）
APIFY_APP_STORE_ACTOR_ID=haketa~app-store-scraper
APIFY_GOOGLE_PLAY_ACTOR_ID=haketa~google-play-scraper
APIFY_PRODUCT_HUNT_ACTOR_ID=glassventures~product-hunt-scraper

# 可选：每个源采集的最大条数
APIFY_APP_STORE_MAX_ITEMS=50
APIFY_GOOGLE_PLAY_MAX_ITEMS=50
APIFY_PRODUCT_HUNT_MAX_ITEMS=10
REDDIT_LIMIT=20

# 可选：单个 Apify run 的最长等待时间（秒）
APIFY_RUN_TIMEOUT_SECS=300
